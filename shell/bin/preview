#!/bin/sh
# preview PATH [LINE [PATTERN [FLAGS]]]: what fzf shows beside the list in rgi, ff, Ctrl-T
# and Alt-C. A file with line numbers, from a little above LINE with LINE marked (bat draws
# it when you have bat); with PATTERN (rgi) the matches in red, by ripgrep, FLAGS saying
# regex (r), case-sensitive (c) and whole word (w) as in rgi. A directory's entries. Plain
# sh, awk and grep otherwise, so it works on any machine.
f=${1:-}
line=${2:-0}
pat=${3:-}
flags=${4:-r}
[ -n "$f" ] || exit 0
# fzf lists may show the home directory as ~ (a literal tilde here).
# shellcheck disable=SC2088
case $f in "~/"*) f=$HOME/${f#"~/"} ;; esac
if [ -d "$f" ]; then
	ls -Ap "$f" 2>/dev/null | head -n 300
	exit 0
fi
[ -r "$f" ] || {
	echo "cannot read $f"
	exit 0
}
case $line in '' | *[!0-9]*) line=0 ;; esac
h=${FZF_PREVIEW_LINES:-40}
case $h in '' | *[!0-9]*) h=40 ;; esac
start=1
if [ "$line" -gt 0 ]; then
	start=$((line - h / 3))
	[ "$start" -lt 1 ] && start=1
fi
end=$((start + h + 20))
if [ -s "$f" ] && ! LC_ALL=C grep -qI . "$f" 2>/dev/null; then
	echo "binary file, $(wc -c <"$f" | tr -d ' ') bytes"
	exit 0
fi
# The hit's line number in yellow on a raised background, the matches in red.
if [ -n "$pat" ] && command -v rg >/dev/null 2>&1; then
	set -- --no-config --color=always --colors=match:fg:red --colors=match:style:bold --passthru --no-line-number
	case $flags in *r*) ;; *) set -- "$@" --fixed-strings ;; esac
	case $flags in *c*) set -- "$@" --case-sensitive ;; *) set -- "$@" --smart-case ;; esac
	case $flags in *w*) set -- "$@" --word-regexp ;; esac
	out=$(rg "$@" -e "$pat" -- "$f" 2>/dev/null | awk -v s="$start" -v e="$end" -v l="$line" '
		NR < s { next }
		NR > e { exit }
		NR == l { printf "\033[48;5;237m\033[38;5;223m%5d\033[0m %s\n", NR, $0; next }
		{ printf "\033[38;5;243m%5d\033[0m %s\n", NR, $0 }')
	if [ -n "$out" ]; then
		printf '%s\n' "$out"
		exit 0
	fi
fi
for b in bat batcat; do
	if command -v "$b" >/dev/null 2>&1; then
		if [ "$line" -gt 0 ]; then
			exec "$b" --color=always --style=numbers --paging=never --line-range "$start:$end" --highlight-line "$line" -- "$f"
		fi
		exec "$b" --color=always --style=numbers --paging=never --line-range "1:$end" -- "$f"
	fi
done
# Line numbers in grey; the hit's line on a raised background with its number in yellow.
awk -v s="$start" -v e="$end" -v l="$line" '
	NR < s { next }
	NR > e { exit }
	NR == l { printf "\033[48;5;237m\033[38;5;223m%5d\033[39m %s\033[K\033[0m\n", NR, $0; next }
	{ printf "\033[38;5;243m%5d\033[0m %s\n", NR, $0 }' "$f"
